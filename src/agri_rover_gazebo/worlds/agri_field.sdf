<?xml version="1.0" ?>

<sdf version="1.9">
  <world name="agri_field">

    <!-- ========================= -->
    <!--       WORLD SYSTEMS       -->
    <!-- ========================= -->

    <!-- Physics -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <!-- User commands -->
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Scene broadcaster -->
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Sensors - required for GPU LiDAR -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>


    <!-- ========================= -->
    <!--           LIGHT            -->
    <!-- ========================= -->

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>


    <!-- ========================= -->
    <!--          GROUND            -->
    <!-- ========================= -->

    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <box>
              <size>8.0 8.0 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <box>
              <size>8.0 8.0 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.25 0.12 1</ambient>
            <diffuse>0.35 0.25 0.12 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!--         CROP ROW 1        -->
    <!-- ========================= -->

    <model name="crop_row_1">
      <static>true</static>
      <pose>0 -2.4 0.4 0 0 0</pose>

      <link name="crop_link">

        <collision name="crop_collision">
          <geometry>
            <box>
              <size>5.0 0.15 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="crop_visual">
          <geometry>
            <box>
              <size>5.0 0.15 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.6 0.1 1</ambient>
            <diffuse>0.1 0.6 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!--         CROP ROW 2        -->
    <!-- ========================= -->

    <model name="crop_row_2">
      <static>true</static>
      <pose>0 -1.2 0.4 0 0 0</pose>

      <link name="crop_link">

        <collision name="crop_collision">
          <geometry>
            <box>
              <size>5.0 0.15 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="crop_visual">
          <geometry>
            <box>
              <size>5.0 0.15 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.6 0.1 1</ambient>
            <diffuse>0.1 0.6 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!--         CROP ROW 3        -->
    <!-- ========================= -->

    <model name="crop_row_3">
      <static>true</static>
      <pose>0 1.2 0.4 0 0 0</pose>

      <link name="crop_link">

        <collision name="crop_collision">
          <geometry>
            <box>
              <size>5.0 0.15 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="crop_visual">
          <geometry>
            <box>
              <size>5.0 0.15 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.6 0.1 1</ambient>
            <diffuse>0.1 0.6 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!--         CROP ROW 4        -->
    <!-- ========================= -->

    <model name="crop_row_4">
      <static>true</static>
      <pose>0 2.4 0.4 0 0 0</pose>

      <link name="crop_link">

        <collision name="crop_collision">
          <geometry>
            <box>
              <size>5.0 0.15 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="crop_visual">
          <geometry>
            <box>
              <size>5.0 0.15 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.6 0.1 1</ambient>
            <diffuse>0.1 0.6 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!--       FIELD BOUNDARY      -->
    <!-- ========================= -->

    <!-- Left boundary -->
    <model name="boundary_left">
      <static>true</static>
      <pose>-3.0 0 0.25 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 7.0 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 7.0 0.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- Right boundary -->
    <model name="boundary_right">
      <static>true</static>
      <pose>3.0 0 0.25 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 7.0 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 7.0 0.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- Front boundary -->
    <model name="boundary_front">
      <static>true</static>
      <pose>0 -3.5 0.25 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>6.0 0.1 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6.0 0.1 0.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- Back boundary -->
    <model name="boundary_back">
      <static>true</static>
      <pose>0 3.5 0.25 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>6.0 0.1 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6.0 0.1 0.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

  </world>
</sdf>
